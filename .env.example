# Database Configuration (PostgreSQL / Supabase or SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./lexai.db

# Supabase (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application Settings
DEBUG=false
APP_NAME=AI Contract Simplifier API
APP_VERSION=1.0.0
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=26214400

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:3000"]

# AI / LLM Configuration (Groq API)
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1