# ─── Database (PostgreSQL / Supabase) ─────────────────────────────────────────
#
# Option A — Supabase Pooler (recommended for serverless / long-running apps)
#   DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
#
# Option B — Supabase Direct Connection
#   DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Service-role key — keep SECRET, never expose to frontend
SUPABASE_SERVICE_ROLE_KEY=

# ─── Application ──────────────────────────────────────────────────────────────
DEBUG=false
APP_NAME=LexAI Simplifier API
APP_VERSION=1.0.0

# ─── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_BYTES=26214400

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://localhost:3000"]

# ─── AI / LLM Configuration ───────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=groq/compound-mini
LLM_PROVIDER=groq
LLM_BASE_URL=
