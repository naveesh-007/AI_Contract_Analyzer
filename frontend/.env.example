# ─── Supabase (frontend — publishable key only) ──────────────────────────────
# Safe to expose in the browser bundle. Never put the service-role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# ─── API ──────────────────────────────────────────────────────────────────────
# Leave blank in development — Vite proxy rewrites /api → http://localhost:8000
# Set to the deployed backend URL in production.
VITE_API_BASE_URL=
